# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/dvp_voting

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ─── Blockchain ───────────────────────────────────────────────────────────────
# Local Hardhat node (default)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private key of the contract owner account (Hardhat Account #0 private key below)
# WARNING: Never commit a real private key — this is the default Hardhat test key
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract address populated by deploy.js — leave empty to read from config/contract.json
CONTRACT_ADDRESS=

# ─── Sepolia testnet (optional) ───────────────────────────────────────────────
SEPOLIA_RPC_URL=

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@dvp.gov
ADMIN_PASSWORD=Admin@SecureVoting2026!
ADMIN_NAME=System Administrator
